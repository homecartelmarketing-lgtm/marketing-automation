# PROMO_BANNER_RESOLUTION=1K (optional: 1K/2K/4K)
# Third banner (1800x600: Sale-colour panel + Krea modern Christmas bedroom with 2 blended table lamps):
# KREA_MOODBOARD_ID_THIRD_BANNER=<Krea bedroom moodboard> (optional - until set, the Sale banner's old bedroom moodboard fb2487fb-2895-4d2c-9758-805aaf1bac69 is used)
