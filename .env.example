# ===================================================================
# Style This Story - BUILT-IN TABLES (fully controlled from .env)
# -------------------------------------------------------------------
# Every value here can be edited in .env - no code changes needed.
# Each built-in category has 4 settings:
#   AIRTABLE_TABLE_ID_STYLE_THIS_<CATEGORY>   -> Airtable table id
#   KREA_MOODBOARD_ID_STYLE_THIS_<CATEGORY>   -> Krea moodboard id
#   STYLE_THIS_PROMPT_<CATEGORY>              -> Krea room-interior prompt
#   STYLE_THIS_AKENEO_CATEGORY_<CATEGORY>     -> which products to scrape
#        (valid: floor_lamps, wall_lights, pendant_lights, chandeliers,
#         cluster_chandeliers)
# ===================================================================

# --- Floor Lamps ---
AIRTABLE_TABLE_ID_STYLE_THIS=tblvSAzXasTVI85r9
