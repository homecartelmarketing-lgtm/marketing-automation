KREA_MOODBOARD_ID_CHANDELIER_MODERN=your_chandelier_modern_moodboard_id


# Tips Feed uses four distinct moodboards at strength 0.23.
KREA_MOODBOARD_ID_TIPS_OUTDOOR=your_tips_outdoor_moodboard_id
KREA_MOODBOARD_ID_TIPS_LIVING_ROOM=your_tips_living_room_moodboard_id
