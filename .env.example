# Qwen through official DashScope Singapore OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus


# Local resumable output cache
CONTENT_AUTOMATION_OUTPUT_DIR=output/content

